<UserControl x:Class="FastGithub.UI.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="640">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e2e2e2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,12,16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1a5c8a"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#8a8a8a"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="22,0,0,6"/>
        </Style>
        <Style x:Key="ItemTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Background" Value="#f4f8fc"/>
            <Setter Property="BorderBrush" Value="#b8d4ea"/>
            <Setter Property="Foreground" Value="#22506f"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="RefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#37aefe"/>
            <Setter Property="BorderBrush" Value="#2b9de9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="#f7f7f7" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,20">

            <!-- 启动与运行 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="启动与运行"/>
                    <CheckBox x:Name="autoStartCheckBox" Content="开机自启（登录 Windows 后自动运行）" Checked="AutoStartCheckBox_Changed" Unchecked="AutoStartCheckBox_Changed"/>
                    <TextBlock Style="{StaticResource HintStyle}" Text="写入当前用户的启动项（注册表 Run），不需要管理员权限，随时可以关闭。"/>
                    <CheckBox x:Name="startMinimizedCheckBox" Content="启动后直接最小化到托盘" Checked="StartMinimizedCheckBox_Changed" Unchecked="StartMinimizedCheckBox_Changed"/>
                    <TextBlock Style="{StaticResource HintStyle}" Text="开启后只在托盘显示图标，左键单击图标可以重新打开主窗口。"/>
                    <CheckBox x:Name="autoRefreshOnStartCheckBox" Content="启动后自动更新一次 IP" Checked="AutoRefreshOnStartCheckBox_Changed" Unchecked="AutoRefreshOnStartCheckBox_Changed"/>
                    <TextBlock Style="{StaticResource HintStyle}" Text="程序启动约 15 秒后自动触发一次 IP 更新，适合经常关机、IP 池容易过期的环境。开机自启时建议开启。"/>
                </StackPanel>
            </Border>

            <!-- IP 更新 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="IP 更新"/>
                    <TextBlock Style="{StaticResource ItemTextStyle}" Margin="0,0,0,8" Text="自动更新间隔"/>
                    <ComboBox x:Name="refreshIntervalComboBox" Width="220" HorizontalAlignment="Left" FontSize="12.5" SelectionChanged="RefreshIntervalComboBox_SelectionChanged">
                        <ComboBoxItem Content="不自动更新" Tag="0"/>
                        <ComboBoxItem Content="每 6 小时" Tag="6"/>
                        <ComboBoxItem Content="每 12 小时" Tag="12"/>
                        <ComboBoxItem Content="每 24 小时" Tag="24"/>
                        <ComboBoxItem Content="每 3 天" Tag="72"/>
                    </ComboBox>
                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,6,0,10" Text="到期后自动在后台执行一次 IP 更新，期间大约 10~30 秒内会占用较多连接。不自动更新时，只有在点「立即更新」或遇到连接失败时才会刷新。"/>
                    <WrapPanel>
                        <Button x:Name="refreshNowButton" Style="{StaticResource RefreshButtonStyle}" Content="立即更新 IP" Click="RefreshNowButton_Click"/>
                        <Button x:Name="openCacheButton" Style="{StaticResource ActionButtonStyle}" Content="查看 IP 缓存" Click="OpenCacheButton_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="lastRefreshText" Style="{StaticResource HintStyle}" Margin="0,2,0,0" Text="上次更新：本次运行尚未更新"/>
                </StackPanel>
            </Border>

            <!-- 提醒 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="提醒"/>
                    <CheckBox x:Name="showBalloonCheckBox" Content="在托盘弹出气泡提醒" Checked="ShowBalloonCheckBox_Changed" Unchecked="ShowBalloonCheckBox_Changed"/>
                    <TextBlock Style="{StaticResource HintStyle}" Text="关闭后仍会在主窗口底部状态栏显示结果，只是不再弹系统气泡。"/>
                </StackPanel>
            </Border>

            <!-- 后端状态 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="加速服务状态"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ItemTextStyle}" Foreground="#777777" Text="运行状态"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="backendStateText" Style="{StaticResource ItemTextStyle}" Text="检测中…"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ItemTextStyle}" Foreground="#777777" Text="程序版本"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="backendVersionText" Style="{StaticResource ItemTextStyle}" Text="—"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ItemTextStyle}" Foreground="#777777" Text="内部端口"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="backendPortText" Style="{StaticResource ItemTextStyle}" Text="—"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ItemTextStyle}" Foreground="#777777" Text="拦截方式"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ItemTextStyle}" Text="WinDivert 驱动拦截 DNS 与 TCP，不修改 hosts、不设置系统代理"/>
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource ActionButtonStyle}" Content="刷新状态" Click="RefreshStateButton_Click"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="检测更新" Click="CheckUpdateButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 工具 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="目录与诊断"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="打开日志目录" Click="OpenLogsButton_Click"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="打开配置目录" Click="OpenConfigButton_Click"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="打开程序目录" Click="OpenRootButton_Click"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,2,0,0" Text="日志按天分文件，最新的一份就是当前进程；appsettings 目录里是按网站分组的域名规则，修改后需要重启程序生效。"/>
                </StackPanel>
            </Border>

            <TextBlock FontSize="11.5" Foreground="#9a9a9a" TextWrapping="Wrap" Margin="2,0,0,0"
                       Text="以上设置只保存在当前用户下（%LOCALAPPDATA%），修改后立即生效，不需要重启程序。"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
